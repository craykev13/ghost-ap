[Unit]
Description=GhostAP: join WiFi or fall back to an access point
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
# RemainAfterExit keeps the service "active" after the script exits, so systemd
# doesn't tear down hostapd/dnsmasq the moment `start` finishes.
RemainAfterExit=yes
# KillMode=process: if the controller itself is killed or times out, systemd
# kills ONLY the controller, never hostapd/dnsmasq. Once the rescue timer is
# disarmed, a working AP must not die just because its launcher did.
# (A deliberate `systemctl stop` still cleans up, via ExecStop below.)
KillMode=process
# Launched through python3 on purpose: it keeps working even if a copy of the
# script loses its executable bit (which would otherwise break boot silently).
ExecStart=/usr/bin/python3 /usr/local/bin/ghostap start
ExecStop=/usr/bin/python3 /usr/local/bin/ghostap stop

[Install]
WantedBy=multi-user.target