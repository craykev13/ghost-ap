[Unit]
Description=GhostAP admin page
After=network.target

[Service]
# The `ghostap` command is a link into the cloned repo, which lives in a home folder, so
# this can't run as a throwaway user (it couldn't open its own program). It runs as root
# with every privilege removed except the one that lets it read that folder, and with the
# rest of the system mounted read-only (except the config folder, for the Settings page).
ExecStart=/usr/bin/python3 /usr/local/bin/ghostap gui
Restart=on-failure
RestartSec=5
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadOnlyPaths=-/run/ghostap
# The Settings page edits the config file (and keeps one .bak copy beside it).
ReadWritePaths=/etc/ghostap
# Its own folder for leaving requests for ghostap-apply.path (nothing else is writable).
RuntimeDirectory=ghostap-gui

[Install]
WantedBy=multi-user.target
